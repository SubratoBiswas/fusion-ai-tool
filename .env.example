# MongoDB connection string (e.g. MongoDB Atlas). If unset, an in-memory
# mongomock instance is used — fine for local dev, data is not persisted.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB=fusiontrials

# Anthropic API key for AI-powered features.
# Without it, FusionTrials runs in offline mode with rule-based fallbacks.
ANTHROPIC_API_KEY=sk-ant-...
